{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd relieflink/admin && npm install",
  "buildCommand": "cd relieflink/admin && npm run build",
  "outputDirectory": "relieflink/admin/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://relieflink-api.onrender.com/api/$1" },
    { "source": "/health", "destination": "https://relieflink-api.onrender.com/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
