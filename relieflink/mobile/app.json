{
  "expo": {
    "name": "ReliefLink",
    "slug": "relieflink",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "relieflink",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F8FAFC",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pk.relieflink.app"
    },
    "android": {
      "package": "pk.relieflink.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "http://localhost:8000/api/v1"
    }
  }
}
