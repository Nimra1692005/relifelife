# ═══════════════════════════════════════════════════════════
# ReliefLink Backend — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── App ────────────────────────────────────────────────────
APP_NAME=ReliefLink API
ENVIRONMENT=production
DEBUG=false

# ─── Supabase (Free: https://supabase.com) ──────────────────
# 1. Go to supabase.com → New Project
# 2. Copy Project URL and API Keys from Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ─── Weather Intelligence (Free: https://openweathermap.org) ─
# 1. Sign up at openweathermap.org
# 2. Go to API Keys → Create key
# 3. Free tier: 1000 calls/day, 60 calls/minute
WEATHER_PROVIDER=openweathermap
WEATHER_API_KEY=your-openweathermap-api-key

# ─── AI Chatbot (Free: https://console.groq.com) ────────────
# 1. Sign up at console.groq.com
# 2. Go to API Keys → Create key
# 3. Free tier: llama-3.2-3b-preview model
# Note: Using Groq instead of OpenAI for free tier
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── CORS Origins ────────────────────────────────────────────
# Comma-separated list of allowed frontend URLs
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,https://your-app.vercel.app

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
SOS_RATE_LIMIT_PER_MINUTE=10
