# ReliefLink Environment Variables
# Copy this file to .env and fill in your own keys
# NEVER commit the real .env file to GitHub

# OpenWeatherMap API Key (free tier: https://openweathermap.org/api)
OWM_KEY=your_openweathermap_api_key_here

# Groq API Key (free tier: https://console.groq.com/keys)
GROQ_KEY=your_groq_api_key_here

# Supabase Configuration (backend only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Application Settings
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,https://yourusername.github.io
