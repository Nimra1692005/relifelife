# ReliefLink — Vercel + Supabase environment variables
# Set these in Vercel → Project → Settings → Environment Variables.
# NEVER commit a real .env to GitHub.

# Supabase (Dashboard → Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Admin dashboard sign-in credentials
ADMIN_EMAIL=admin@relieflink.pk
ADMIN_PASSWORD=choose-a-strong-password

# Application Settings
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,https://yourusername.github.io
